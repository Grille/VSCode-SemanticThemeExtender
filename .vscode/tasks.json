{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "npm run compile",
      // PowerShell's default execution policy blocks npm.ps1; cmd uses npm.cmd instead.
      "windows": { "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } } },
      "problemMatcher": "$tsc",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
