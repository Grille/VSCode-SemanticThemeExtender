{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      // Claude Code is left out: its auto-update keeps retrying in every window, and test windows
      // crashed (exit code 134) right around those attempts. The test window doesn't need it.
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extension=anthropic.claude-code"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "compile"
    },
    {
      // Copilot Chat logs "EXTENSION WILL BE BROKEN" in development hosts right before the
      // extension host crashes (exit code 134); this keeps every other extension.
      "name": "Run Extension (without Claude Code and Copilot Chat)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=anthropic.claude-code",
        "--disable-extension=github.copilot-chat"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "compile"
    },
    {
      // Only this extension: no language servers (so no semantic tokens), but the rules editor,
      // swatches and writing settings work. Useful when other extensions crash the dev host.
      "name": "Run Extension (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "compile"
    }
  ]
}
