; Rules for this project only, on top of the global rules (Semantic Theme Extender: Open Rules).
; Same language; everything here is drawn as decorations over the language server's tokens, in
; this workspace folder only, so semantic selectors only: no UI colors or TextMate scopes.
; Applied on save.

; What things are: custom modifiers, selectable as class.slotted here and in the global rules.
@contains_slots => contains(text("__slots__") variable.classMember)

language(python) {
  @contains_slots class += slotted
  ; Subclasses of a slotted class that don't declare __slots__ themselves get a __dict__ again.
  inherits(class.slotted) & !class.slotted += leaky
}

; How they look; this part could just as well live in the global rules.
class.slotted = style(struct, bold)
class.leaky = style(function, bold | italic)
