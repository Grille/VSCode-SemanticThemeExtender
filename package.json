{
  "name": "semantic-theme-extender",
  "displayName": "Semantic Theme Extender",
  "description": "Colors what your theme leaves out: structs, interfaces, enums and more, derived from the theme's own palette. A rules file colors tokens by what the language server knows: base types, decorators, docs, members.",
  "preview": true,
  "version": "0.1.0",
  "publisher": "Grille",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grille/VSCode-SemanticThemeExtender.git"
  },
  "homepage": "https://github.com/Grille/VSCode-SemanticThemeExtender#readme",
  "bugs": {
    "url": "https://github.com/Grille/VSCode-SemanticThemeExtender/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "semantic highlighting",
    "semantic tokens",
    "struct",
    "interface",
    "type parameter",
    "theme",
    "visual studio"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:semantic-theme-rules"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec \"out-test/test/*.test.js\"",
    "test:servers": "tsc -p tsconfig.test.json && node --test --test-reporter=spec --test-concurrency=1 \"out-test/test/servers/*.test.js\"",
    "test:vscode": "npm run compile && tsc -p tsconfig.test.json && node out-test/test/vscode/run.js",
    "bench": "tsc -p tsconfig.test.json && node out-test/test/servers/benchmark.js",
    "vscode:prepublish": "npm run compile"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Project rules (.vscode/semantic-theme.str) are only applied in trusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "semanticThemeExtender.openRules",
        "title": "Open Rules",
        "category": "Semantic Theme Extender"
      },
      {
        "command": "semanticThemeExtender.openProjectRules",
        "title": "Open Project Rules",
        "category": "Semantic Theme Extender"
      },
      {
        "command": "semanticThemeExtender.apply",
        "title": "Apply Semantic Color Rules",
        "category": "Semantic Theme Extender"
      },
      {
        "command": "semanticThemeExtender.inspectToken",
        "title": "Inspect Token",
        "category": "Semantic Theme Extender"
      },
      {
        "command": "semanticThemeExtender.showResolved",
        "title": "Show Resolved Theme Colors",
        "category": "Semantic Theme Extender"
      },
      {
        "command": "semanticThemeExtender.resetRules",
        "title": "Reset Rules to Defaults",
        "category": "Semantic Theme Extender"
      },
      {
        "command": "semanticThemeExtender.remove",
        "title": "Remove Generated Rules",
        "category": "Semantic Theme Extender"
      }
    ],
    "languages": [
      {
        "id": "semantic-theme-rules",
        "aliases": [
          "Semantic Theme Rules"
        ],
        "extensions": [
          ".str"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "semantic-theme-rules",
        "scopeName": "source.semantic-theme-rules",
        "path": "./syntaxes/semantic-theme-rules.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "basedpyright": "^1.40.2",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.2"
  }
}
