{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Semantic Theme Rules",
  "scopeName": "source.semantic-theme-rules",
  "patterns": [
    { "match": ";.*$", "name": "comment.line.semicolon.semantic-theme-rules" },
    { "match": "\"[^\"]*\"?", "name": "string.quoted.double.semantic-theme-rules" },
    {
      "match": "\\b(match)\\s*\\(\\s*(\\$[\\w-]+)\\s*\\)",
      "captures": {
        "1": { "name": "keyword.control.match.semantic-theme-rules" },
        "2": { "name": "variable.language.builtin.semantic-theme-rules" }
      }
    },
    { "match": "\\boverride(?!\\s*=)(?=\\s*[{A-Za-z_*$])", "name": "keyword.control.override.semantic-theme-rules" },
    { "match": "\\b(?:contains|within|inherits)(?=\\s*\\()", "name": "keyword.control.symbol.semantic-theme-rules" },
    { "match": "\\b(?:text|doc)(?=\\s*\\()", "name": "keyword.control.text.semantic-theme-rules" },
    { "match": "@[\\w-]*", "name": "entity.name.function.expression.semantic-theme-rules" },
    { "match": "\\blanguage(?=\\s*\\()", "name": "keyword.control.language.semantic-theme-rules" },
    { "match": "\\b(?:ui|semantic|textmate)(?!\\s*=)(?=\\s+[A-Za-z_*]|\\s*\\{)", "name": "keyword.control.kind.semantic-theme-rules" },
    {
      "match": "(\\$[\\w-]+)\\s*(=)(?!=)",
      "captures": {
        "1": { "name": "variable.other.definition.semantic-theme-rules" },
        "2": { "name": "keyword.operator.assignment.semantic-theme-rules" }
      }
    },
    {
      "match": "((?:\\*(?=[.:\\s])|[A-Za-z_])(?:[\\w.:]|-(?=\\w))*)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.constant.selector.semantic-theme-rules" },
        "2": { "name": "keyword.operator.assignment.semantic-theme-rules" }
      }
    },
    { "match": "\\$(theme|type|none)\\b", "name": "variable.language.builtin.semantic-theme-rules" },
    { "match": "\\$[\\w-]+", "name": "variable.other.semantic-theme-rules" },
    { "match": "#[0-9a-fA-F]{3,8}\\b", "name": "constant.numeric.color.semantic-theme-rules" },
    { "match": "->|=>", "name": "keyword.operator.arrow.semantic-theme-rules" },
    {
      "match": "(:=)\\s*(error|warn|info|hint)(?=\\s*\\()",
      "captures": {
        "1": { "name": "keyword.operator.assignment.semantic-theme-rules" },
        "2": { "name": "support.function.semantic-theme-rules" }
      }
    },
    {
      "match": "(\\+=)\\s*([A-Za-z_][\\w-]*(?:\\s*,\\s*[A-Za-z_][\\w-]*)*)",
      "captures": {
        "1": { "name": "keyword.operator.assignment.semantic-theme-rules" },
        "2": { "name": "entity.other.attribute-name.modifier.semantic-theme-rules" }
      }
    },
    { "match": "[&|!]", "name": "keyword.operator.logical.semantic-theme-rules" },
    { "match": "\\b(dark|light|contrast)\\b(?!\\s*(?:=|\\())", "name": "constant.language.flag.semantic-theme-rules" },
    { "match": "\\b_\\b", "name": "constant.language.wildcard.semantic-theme-rules" },
    { "match": "\\b(bold|italic|underline|strikethrough)\\b(?!\\s*\\()", "name": "constant.language.style.semantic-theme-rules" },
    { "match": "\\b(style|offset|emphasize|soften|lighten|darken|saturate|desaturate|hue|mix|alpha|rgba?)(?=\\s*\\()", "name": "support.function.semantic-theme-rules" },
    { "match": "[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:%|deg\\b|°)?", "name": "constant.numeric.semantic-theme-rules" },
    { "match": "\\b[A-Za-z_](?:[\\w.:]|-(?=\\w))*", "name": "variable.other.constant.theme-ref.semantic-theme-rules" },
    { "match": "[{}()]", "name": "punctuation.section.semantic-theme-rules" },
    { "match": ",", "name": "punctuation.separator.semantic-theme-rules" }
  ]
}
